[{"id":20230117,"question":"已知在 $\\triangle ABC$ 中，$A+B=3C$，$2\\sin(A-C)=\\sin B$。\n(1) 求 $\\sin A$；\n(2) 设 $AB=5$，求 $AB$ 边上的高。","categories":["三角函数"],"type":"大题","year":"2023","region":"全国卷","difficulty":"管线实例评分","completeness":"complete","source_ids":[1],"has_answer":true,"has_images":false,"routine":null},{"id":20250116,"question":"设数列 $\\{a_n\\}$ 满足 $a_1=3$，$\\frac{a_{n+1}}{n}=\\frac{a_n}{n+1}+\\frac{1}{n(n+1)}$。\n(1) 证明：$\\{na_n\\}$ 为等差数列；\n(2) 设 $f(x)=a_1x+a_2x^2+\\cdots+a_mx^m$，求 $f'(-2)$。","categories":["数列"],"type":"大题","year":"2025","region":"全国卷","difficulty":"管线实例评分","completeness":"complete","source_ids":[2],"has_answer":true,"has_images":false,"routine":null}]
