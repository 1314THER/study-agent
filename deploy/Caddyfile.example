# 150.chat has passed ICP filing. Install deploy/public/index.html to
# /var/www/study-agent-public/index.html before loading this config.
# Ubuntu 26.04 ships Caddy 2.6, which uses `basicauth`.
150.chat {
	handle / {
		root * /var/www/study-agent-public
		file_server
	}
	handle {
		basicauth {
			studyadmin REPLACE_WITH_CADDY_HASH_PASSWORD_OUTPUT
		}
		reverse_proxy 127.0.0.1:8000
	}
}
