# Copy this file to .env and add your own keys, or use the web Settings page.
# The project works for browsing the included data without API keys.
DEEPSEEK_API_KEY=

# Persistent accounts are opt-in. Public deployments should enable this.
STUDY_AUTH_ENABLED=0
# Keep these directories separate from the project and guest sessions.
STUDY_AUTH_ROOT=/var/lib/study-agent/accounts
# Existing owner's data root; unset keeps the legacy project/backend paths.
# STUDY_OWNER_DATA_DIR=/opt/study-agent
# Generate once: python scripts/bootstrap_owner.py --generate-key
# Store outside the repository and back up; losing it makes user API keys unreadable.
STUDY_AUTH_ENCRYPTION_KEY=
STUDY_AUTH_ORIGIN=https://your-domain.example
# Production must use Secure HttpOnly cookies over HTTPS. Set 0 only for local preview.
STUDY_AUTH_COOKIE_SECURE=1

# Email registration stays disabled until all SMTP fields are configured.
# Use a provider-approved sending mailbox/domain and an SMTP application password.
STUDY_SMTP_HOST=
STUDY_SMTP_PORT=465
STUDY_SMTP_SECURITY=ssl
STUDY_SMTP_USERNAME=
STUDY_SMTP_PASSWORD=
STUDY_SMTP_FROM=
# SMS registration is explicitly disabled; no SMS credentials are needed.

# Guests use only a server-prepared, read-only DeepSeek snapshot.
# STUDY_DEMO_AI_CONFIG=/etc/study-agent-demo/ai.json
STUDY_DEMO_AI_ENABLED=1
