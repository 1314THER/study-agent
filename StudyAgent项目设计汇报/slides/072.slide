        [{ text: '历史同步骤反复出错，本次仍错', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '优先提示能力不稳定', textStyle: { fontSize: 16 } }, { text: '安排该步骤专项训练并复测', textStyle: { fontSize: 16 } }],
        [{ text: '历史能独立完成，本次因前题耗时未作答', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '核实策略与时间安排', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '比较限时与不限时表现', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '仅一次错误，或出现在更高难度变式', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '保留未知', textStyle: { fontSize: 16 } }, { text: '不直接归因，等待更多证据', textStyle: { fontSize: 16 } }]]} /></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：试卷与生涯维度设计思路.md §7</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 72 / 124 </Text></Box></Slide>