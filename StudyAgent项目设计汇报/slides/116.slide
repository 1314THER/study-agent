<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '20px 70px', display: 'flex', flexDirection: 'column' }}><Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}><Box style={{ flexDirection: 'column', gap: 6 }}><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4, letterSpacing: 1 }}>12 / 自进化与扩展</Text><Text style={{ fontSize: 32, color: '#0E2340', fontWeight: 700, lineHeight: 1.3 }}>三类技术路径与各自的边界</Text></Box><Box style={{ flexDirection: 'row', alignItems: 'center', padding: '7px 16px', borderRadius: 20, background: '#1E7BE0' }}><Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>设计中</Text></Box></Box><Box style={{ height: 532, paddingTop: 8, flexDirection: 'column' }}><Box style={{ flexDirection: 'column', flex: 1, paddingTop: 4 }}><Box style={{ marginBottom: 14 }}><Box style={{ flexDirection: 'row', alignItems: 'center', background: '#F5F7FA', borderLeft: '4px solid #0E2340', borderRadius: 6, padding: '14px 20px' }}><Text style={{ fontSize: 20, color: '#0E2340', fontWeight: 600, lineHeight: 1.5 }}>术语澄清：“基于基座重新训练”可指从同一预训练基座训练新任务版本，也可指继续训练，两者都不同于从零预训练通用大模型</Text></Box></Box><Box style={{ flex: 1 }}><Table style={{ width: '100%', height: '100%' }} defaultTextStyle={{ fontSize: 16, textAlign: 'left', color: '#333A45' }} defaultCellStyle={{ padding: 10, border: { left: { width: 1, color: '#E3E8EF' }, right: { width: 1, color: '#E3E8EF' }, top: { width: 1, color: '#E3E8EF' }, bottom: { width: 1, color: '#E3E8EF' } } }} cells={[[{ text: '路径', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '改变什么', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '主要边界', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }],
        [{ text: '知识库、案例检索与提示词', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '改变运行时材料与要求，不改变模型权重', textStyle: { fontSize: 16 } }, { text: '适用于已核实的案例与规则修正，成本最低', textStyle: { fontSize: 16 } }],
        [{ text: '本地基座的任务微调', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '改变模型或适配器参数', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '需核实数据与独立评测，不能只看训练误差；LoRA 降低部分训练成本，不保证少量教师反馈就足以得到可靠教学模型', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '更大范围的训练', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '持续预训练、全量微调或另起训练版本', textStyle: { fontSize: 16 } }, { text: '成本与验证要求更高，不作为默认解法', textStyle: { fontSize: 16 } }]]} /></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：自进化与跨学科扩展设计.md §2.2</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 116 / 124 </Text></Box></Slide>