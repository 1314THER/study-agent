 width='584' height='28' rx='14' fill='#EAF3FD'/><text x='30' y='231' font-size='14' fill='#1E7BE0' text-anchor='start' font-weight='600'>同一课时四种组织方式：前置检查型 / 典型问题型 / 多解法对比型 / 小组活动型</text><rect x='18' y='248' width='584' height='34' rx='17' fill='#1E7BE0'/><text x='310.0' y='271' font-size='15' fill='#FFFFFF' text-anchor='middle' font-weight='600'>生成可编辑教案</text><text x='608' y='390' font-size='12' fill='#7A8699' text-anchor='end' font-weight='400'>示意占位 · S14</text></svg></Box><Box style={{ flex: 1, flexDirection: 'column', gap: 10, justifyContent: 'center' }}><Text style={{ fontSize: 21, color: '#0E2340', fontWeight: 700, lineHeight: 1.4 }}>界面要点</Text><Box style={{ flexDirection: 'column', gap: 9 }}><Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}><Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E7BE0', marginTop: 9 }} /><Box style={{ flex: 1 }}><Text style={{ fontSize: 16, color: '#333A45', fontWeight: 400, lineHeight: 1.6 }}>五项输入：课时、教学目标、教材版本、授课时长、班级前置知识情况。</Text></Box></Box><Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}><Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E7BE0', marginTop: 9 }} /><Box style={{ flex: 1 }}><Text style={{ fontSize: 16, color: '#333A45', fontWeight: 400, lineHeight: 1.6 }}>生成可编辑教案，含七项要素：知识点、易混淆概念、前置检查、例题、讲解步骤、课堂练习、课后任务。</Text></Box></Box><Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}><Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E7BE0', marginTop: 9 }} /><Box style={{ flex: 1 }}><Text style={{ fontSize: 16, color: '#333A45', fontWeight: 400, lineHeight: 1.6 }}>同一课时可生成四种不同组织方式。</Text></Box></Box><Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}><Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E7BE0', marginTop: 9 }} /><Box style={{ flex: 1 }}><Text style={{ fontSize: 16, color: '#333A45', fontWeight: 400, lineHeight: 1.6 }}>补课需求须说明触发该建议的学情证据。</Text></Box></Box><Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}><Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E7BE0', marginTop: 9 }} /><Box style={{ flex: 1 }}><Text style={{ fontSize: 16, color: '#333A45', fontWeight: 400, lineHeight: 1.6 }}>未核实的生成内容在发布和课堂使用前完成核对。</Text></Box></Box></Box><Box style={{ marginTop: 6, padding: '9px 14px', background: '#F5F7FA', borderRadius: 6, alignSelf: 'flex-start' }}><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 600, lineHeight: 1.4 }}>示意占位 S14 · 待替换为实际截图</Text></Box></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：教师端设计思路.md §2</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 49 / 124 </Text></Box></Slide>