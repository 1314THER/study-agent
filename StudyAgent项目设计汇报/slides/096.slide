<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '20px 70px', display: 'flex', flexDirection: 'column' }}><Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}><Box style={{ flexDirection: 'column', gap: 6 }}><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4, letterSpacing: 1 }}>10 / 待深化研究</Text><Text style={{ fontSize: 32, color: '#0E2340', fontWeight: 700, lineHeight: 1.3 }}>五个研究方向的范围与定位</Text></Box><Box style={{ flexDirection: 'row', alignItems: 'center', padding: '7px 16px', borderRadius: 20, background: '#98A2B3' }}><Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>待研究</Text></Box></Box><Box style={{ height: 532, paddingTop: 8, flexDirection: 'column' }}><Box style={{ flexDirection: 'column', flex: 1, paddingTop: 4 }}><Box style={{ marginBottom: 14 }}><Box style={{ flexDirection: 'row', alignItems: 'center', background: '#F5F7FA', borderLeft: '4px solid #0E2340', borderRadius: 6, padding: '14px 20px' }}><Text style={{ fontSize: 20, color: '#0E2340', fontWeight: 600, lineHeight: 1.5 }}>通用原则：分清可观察记录、系统解释、教师确认、学习效果；论文方法只提供研究依据，不能据此推断本项目已有同样效果</Text></Box></Box><Box style={{ flex: 1 }}><Table style={{ width: '100%', height: '100%' }} defaultTextStyle={{ fontSize: 16, textAlign: 'left', color: '#333A45' }} defaultCellStyle={{ padding: 10, border: { left: { width: 1, color: '#E3E8EF' }, right: { width: 1, color: '#E3E8EF' }, top: { width: 1, color: '#E3E8EF' }, bottom: { width: 1, color: '#E3E8EF' } } }} cells={[[{ text: '编号', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '方向', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '定位', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '当前处理方式', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }],
        [{ text: '4', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '分级提示与逐步撤除', textStyle: { fontSize: 16 } }, { text: '保留深入研究', textStyle: { fontSize: 16 } }, { text: '研究“怎样从帮助完成转向独立完成”，不直接并入已实现教学能力', textStyle: { fontSize: 16 } }],
        [{ text: '6', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '错误传播分析与纠错回溯', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '详细研究', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '学生错误依赖关系 + 系统自身错误如何影响后续记录，两者分别建模', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '7', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '教师干预的跟踪记录', textStyle: { fontSize: 16 } }, { text: '详细研究', textStyle: { fontSize: 16 } }, { text: '从发现问题 → 行动 → 复测 → 后续判断', textStyle: { fontSize: 16 } }],
        [{ text: '8', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '低门槛接入、识别确认与断网恢复', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '详细研究', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '纸面导入、识别核对、断网恢复、已有客户端衔接', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '9', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '数学解释、探究与多解法', textStyle: { fontSize: 16 } }, { text: '保留深入研究', textStyle: { fontSize: 16 } }, { text: '开放任务的组织和评价，不把固定套路体系直接当成完整能力量表', textStyle: { fontSize: 16 } }]]} /></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：待深化功能研究.md §1</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 96 / 124 </Text></Box></Slide>