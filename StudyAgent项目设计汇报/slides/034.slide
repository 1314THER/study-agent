<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '20px 70px', display: 'flex', flexDirection: 'column' }}><Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}><Box style={{ flexDirection: 'column', gap: 6 }}><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4, letterSpacing: 1 }}>03 / 单题引擎</Text><Text style={{ fontSize: 32, color: '#0E2340', fontWeight: 700, lineHeight: 1.3 }}>五大功能如何衔接成闭环</Text></Box><Box style={{ flexDirection: 'row', alignItems: 'center', padding: '7px 16px', borderRadius: 20, background: '#1E9E62' }}><Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>已实现</Text></Box></Box><Box style={{ height: 532, paddingTop: 8, flexDirection: 'column' }}><Box style={{ flexDirection: 'row', gap: 28, flex: 1 }}><Box style={{ width: 740, justifyContent: 'center' }}><svg width={740} height={500} viewBox='0 0 740 500'><circle cx='370' cy='250' r='172' fill='none' stroke='#E3E8EF' stroke-width='2' stroke-dasharray='6 6'/><path d='M370.0 78.0 Q456.4 100.4 519.0 164.0' fill='none' stroke='#1E7BE0' stroke-width='2'/><path d='M519.0 164.0 Q542.8 250.0 519.0 336.0' fill='none' stroke='#1E7BE0' stroke-width='2'/><path d='M519.0 336.0 Q456.4 399.6 370.0 422.0' fill='none' stroke='#1E7BE0' stroke-width='2'/><path d='M370.0 422.0 Q283.6 399.6 221.0 336.0' fill='none' stroke='#1E7BE0' stroke-width='2'/><path d='M221.0 336.0 Q197.2 250.0 221.0 164.0' fill='none' stroke='#1E7BE0' stroke-width='2'/><path d='M221.0 164.0 Q283.6 100.4 370.0 78.0' fill='none' stroke='#1E7BE0' stroke-width='2'/><rect x='304.0' y='50.0' width='132' height='56' rx='8' fill='#FFFFFF' stroke='#1E7BE0' stroke-width='1.5'/><circle cx='304.0' cy='50.0' r='14' fill='#0E2340'/><text x='304.0' y='55.0' font-size='15' fill='#FFFFFF' text-anchor='middle' font-weight='700'>1</text><text x='376.0' y='83.0' font-size='16' fill='#0E2340' text-anchor='middle' font-weight='600'>AI 解题</text><rect x='453.0' y='136.0' width='132' height='56' rx='8' fill='#FFFFFF' stroke='#1E7BE0' stroke-width='1.5'/><circle cx='453.0' cy='136.0' r='14' fill='#0E2340'/><text x='452.9563694509234' y='141.0' font-size='15' fill='#FFFFFF' text-anchor='middle' font-weight='700'>2</text><text x='524.9563694509234' y='169.0' font-size='16' fill='#0E2340' text-anchor='middle' font-weight='600'>AI 改题</text><rect x='453.0' y='308.0' width='132' height='56' rx='8' fill='#FFFFFF' stroke='#1E7BE0' stroke-width='1.5'/><circle cx='453.0' cy='308.0' r='14' fill='#0E2340'/><text x='452.9563694509235' y='313.0' font-size='15' fill='#FFFFFF' text-anchor='middle' font-weight='700'>3</text><text x='524.9563694509235' y='341.0' font-size='16' fill='#0E2340' text-anchor='middle' font-weight='600'>手把手教学</text><rect x='304.0' y='394.0' width='132' height='56' rx='8' fill='#FFFFFF' stroke='#1E7BE0' stroke-width='1.5'/><circle cx='304.0' cy='394.0' r='14' fill='#0E2340'/><text x='304.0' y='399.0' font-size='15' fill='#FFFFFF' text-anchor='middle' font-weight='700'>4</text><text x='376.0' y='427.0' font-size='16' fill='#0E2340' text-anchor='middle' font-weight='600'>AI 出题</text><rect x='155.0' y='308.0' width='132' height='56' rx='8' fill='#FFFFFF' stroke='#1E7BE0' stroke-width='1.5'/><circle cx='155.0' cy='308.0' r='14' fill='#0E2340'/><text x='155.04363054907657' y='313.00000000000006' font-size='15' fill='#FFFFFF' text-anchor='middle' font-weight='700'>5</text><text x='227.04363054907657' y='341.00000000000006' font-size='16' fill='#0E2340' text-anchor='middle' font-weight='600'>错题与题库</text><rect x='155.0' y='136.0' width='132' height='56' rx='8' fill='#FFFFFF' stroke='#1E7BE0' stroke-width='1.5'/><circle cx='155.0' cy='136.0' r='14' fill='#0E2340'/><text x='155.04363054907657' y='141.0' font-size='15' fill='#FFFFFF' text-anchor='middle' font-weight='700'>6</text><text x='227.04363054907657' y='169.0' font-size='16' fill='#0E2340' text-anchor='middle' font-weight='600'>新题独立作答</text><circle cx='370' cy='250' r='72' fill='#0E2340'/><text x='370.0' y='256.0' font-size='17' fill='#FFFFFF' text-anchor='middle' font-weight='600'>复用同一套步骤表示</text></svg></Box><Box style={{ flex: 1, flexDirection: 'column', gap: 11, justifyContent: 'center' }}><Text style={{ fontSize: 21, color: '#0E2340', fontWeight: 700, lineHeight: 1.4 }}>闭环解读</Text><Box style={{ flexDirection: 'column', gap: 10 }}><Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}><Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E7BE0', marginTop: 9 }} /><Box style={{ flex: 1 }}><Text style={{ fontSize: 17, color: '#333A45', fontWeight: 400, lineHeight: 1.6 }}>AI 解题建立参考步骤，AI 改题将学生表现及可用笔迹时间线对应到步骤。</Text></Box></Box><Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}><Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E7BE0', marginTop: 9 }} /><Box style={{ flex: 1 }}><Text style={{ fontSize: 17, color: '#333A45', fontWeight: 400, lineHeight: 1.6 }}>手把手教学围绕薄弱步骤引导，AI 出题把训练需求变成新练习。</Text></Box></Box><Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}><Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E7BE0', marginTop: 9 }} /><Box style={{ flex: 1 }}><Text style={{ fontSize: 17, color: '#333A45', fontWeight: 400, lineHeight: 1.6 }}>错题与题库承接过程记录、步骤错因和练习材料。</Text></Box></Box><Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}><Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E7BE0', marginTop: 9 }} /><Box style={{ flex: 1 }}><Text style={{ fontSize: 17, color: '#333A45', fontWeight: 400, lineHeight: 1.6 }}>新题的独立作答又提供新的步骤证据，回到循环起点。</Text></Box></Box><Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}><Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E7BE0', marginTop: 9 }} /><Box style={{ flex: 1 }}><Text style={{ fontSize: 17, color: '#333A45', fontWeight: 400, lineHeight: 1.6 }}>设计价值：复用同一套步骤表示，使错误定位、教学动作和练习目标能够具体对应。</Text></Box></Box><Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}><Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E7BE0', marginTop: 9 }} /><Box style={{ flex: 1 }}><Text style={{ fontSize: 17, color: '#333A45', fontWeight: 400, lineHeight: 1.6 }}>两条限制：步骤标签本身不能代替数学判断；四项功能都依赖上游参考解析的质量。</Text></Box></Box></Box></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：单题功能设计思路.md §7</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 34 / 124 </Text></Box></Slide>