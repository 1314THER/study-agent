        [{ text: '课时', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '增删、拆分、合并、重排，形成校本课程安排', textStyle: { fontSize: 16 } }, { text: '教材目录、教学知识点、前置和作业', textStyle: { fontSize: 16 } }],
        [{ text: '知识点', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '修订定义与层级，处理同义名和教材版本差异', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '题目、步骤、课时及历史评价', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '步骤', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '调整操作定义、粒度、前置和难度基准', textStyle: { fontSize: 16 } }, { text: '套路组合、参考解析、批改与训练目标', textStyle: { fontSize: 16 } }],
        [{ text: '套路', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '增删合并题类、调整适用条件和学习顺序', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '步骤路径、母题、变式及掌握记录', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '模板与规则', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '定制试卷模板、作业结构、复查间隔和评价权重', textStyle: { fontSize: 16 } }, { text: '评分依据、推荐行为及报告口径', textStyle: { fontSize: 16 } }],
