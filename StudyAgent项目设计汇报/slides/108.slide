<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '20px 70px', display: 'flex', flexDirection: 'column' }}><Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}><Box style={{ flexDirection: 'column', gap: 6 }}><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4, letterSpacing: 1 }}>11 / 落地与边界</Text><Text style={{ fontSize: 32, color: '#0E2340', fontWeight: 700, lineHeight: 1.3 }}>教师在完整模式中的六个工作阶段</Text></Box><Box style={{ flexDirection: 'row', alignItems: 'center', padding: '7px 16px', borderRadius: 20, background: '#1E7BE0' }}><Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>设计中</Text></Box></Box><Box style={{ height: 532, paddingTop: 8, flexDirection: 'column' }}><Box style={{ flexDirection: 'column', flex: 1, paddingTop: 4 }}><Box style={{ marginBottom: 14 }}><Box style={{ flexDirection: 'row', alignItems: 'center', background: '#F5F7FA', borderLeft: '4px solid #0E2340', borderRadius: 6, padding: '14px 20px' }}><Text style={{ fontSize: 20, color: '#0E2340', fontWeight: 600, lineHeight: 1.5 }}>预期变化：减少重复整理与常规处理，将更多精力用于理解困难、课堂互动和个别支持</Text></Box></Box><Box style={{ flex: 1 }}><Table style={{ width: '100%', height: '100%' }} defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#333A45' }} defaultCellStyle={{ padding: 10, border: { left: { width: 1, color: '#E3E8EF' }, right: { width: 1, color: '#E3E8EF' }, top: { width: 1, color: '#E3E8EF' }, bottom: { width: 1, color: '#E3E8EF' } } }} cells={[[{ text: '阶段', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '教师主要行动', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '系统支持', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#0E2340' } } }],
        [{ text: '备课前', textStyle: { fontWeight: 600, fontSize: 15 } }, { text: '确认本课目标，核实前置和共性困难', textStyle: { fontSize: 15 } }, { text: '汇总课时关系与学情，准备教案和例题草稿', textStyle: { fontSize: 15 } }],
        [{ text: '课堂中', textStyle: { fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '组织讲解、讨论、演示与短诊断，观察学生理解', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '提供分步素材、图形演示和适当课堂反馈', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '作业安排', textStyle: { fontWeight: 600, fontSize: 15 } }, { text: '确认共同任务及个性化差异，检查负担', textStyle: { fontSize: 15 } }, { text: '选题、补充复习、估计任务量并解释推荐', textStyle: { fontSize: 15 } }],
        [{ text: '批改后', textStyle: { fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '复核关键判断，决定全班重讲、小组补充或个别沟通', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '定位步骤问题，汇总可核对的班级证据', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '考试后', textStyle: { fontWeight: 600, fontSize: 15 } }, { text: '核对阶段报告，调整后续课程', textStyle: { fontSize: 15 } }, { text: '联合试卷、作答、时间和历史记录形成分析', textStyle: { fontSize: 15 } }],
        [{ text: '长期跟进', textStyle: { fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '评价进步、开展教研并关注需支持的学生', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '保留变化趋势、跟进任务和复测结果', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }]]} /></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：两种教学模式与应用边界.md §3</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 108 / 124 </Text></Box></Slide>