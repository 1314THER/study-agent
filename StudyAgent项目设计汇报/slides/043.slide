        [{ text: '前置知识充分，但套路练习不足', textStyle: { fontWeight: 600, fontSize: 17 } }, { text: '直接安排该套路的六步循环训练', textStyle: { fontSize: 17 } }],
        [{ text: '某前置知识点有经核实的薄弱表现', textStyle: { fontWeight: 600, fontSize: 17 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '先补该知识点，再回到套路训练', textStyle: { fontSize: 17 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '只在某一步骤反复卡住', textStyle: { fontWeight: 600, fontSize: 17 } }, { text: '安排该步骤的专项补练，再应用回完整题目', textStyle: { fontSize: 17 } }],
        [{ text: '套路题会做，但概念条件辨析弱', textStyle: { fontWeight: 600, fontSize: 17 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '增加知识理解专项测评与变式比较', textStyle: { fontSize: 17 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '知识或套路记录不足', textStyle: { fontWeight: 600, fontSize: 17 } }, { text: '先安排适量诊断，不因缺少记录长期分配较低要求的作业', textStyle: { fontSize: 17 } }]]} /></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：套路层面设计思路.md §4.2</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 43 / 124 </Text></Box></Slide>