<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '20px 70px', display: 'flex', flexDirection: 'column' }}><Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}><Box style={{ flexDirection: 'column', gap: 6 }}><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4, letterSpacing: 1 }}>03 / 单题引擎</Text><Text style={{ fontSize: 32, color: '#0E2340', fontWeight: 700, lineHeight: 1.3 }}>三阶段职责：Solver / Verifier / Formatter</Text></Box><Box style={{ flexDirection: 'row', alignItems: 'center', padding: '7px 16px', borderRadius: 20, background: '#1E9E62' }}><Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>已实现</Text></Box></Box><Box style={{ height: 532, paddingTop: 8, flexDirection: 'column' }}><Box style={{ flexDirection: 'column', flex: 1, gap: 16 }}><Box style={{ height: 240 }}><Table style={{ width: '100%', height: '100%' }} defaultTextStyle={{ fontSize: 16, textAlign: 'left', color: '#333A45' }} defaultCellStyle={{ padding: 10, border: { left: { width: 1, color: '#E3E8EF' }, right: { width: 1, color: '#E3E8EF' }, top: { width: 1, color: '#E3E8EF' }, bottom: { width: 1, color: '#E3E8EF' } } }} cells={[[{ text: '阶段', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '主要任务', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '对后续功能的意义', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }],
        [{ text: 'Solver · 解题', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '理解题目，给出完整解答，识别题目所属板块或校验模板', textStyle: { fontSize: 16 } }, { text: '先获得数学解法，供后续拆分与检查', textStyle: { fontSize: 16 } }],
        [{ text: 'Verifier · 校验与结构化', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '检查解答，按题目或小问分块，再拆成步骤，关联知识点，整理标准过程与详细过程', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '建立批改、教学和仿题可以共同引用的步骤结构', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: 'Formatter · 整理与输出', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '检查一致性，整理为约定结构，补充步骤难度信息', textStyle: { fontSize: 16 } }, { text: '形成前端与后端可以稳定消费的参考解析', textStyle: { fontSize: 16 } }]]} /></Box><Box style={{ flexDirection: 'row', alignItems: 'center', background: '#F5F7FA', borderLeft: '4px solid #00A9B5', borderRadius: 6, padding: '14px 20px' }}><Text style={{ fontSize: 17, color: '#0E2340', fontWeight: 600, lineHeight: 1.5 }}>标准过程用于呈现关键推导与得分内容，详细过程用于帮助理解；系统可以按步骤展示、引用和处理解析，不必反复从长篇自然语言中猜测其组织方式</Text></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：单题功能设计思路.md §2.2</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 24 / 124 </Text></Box></Slide>