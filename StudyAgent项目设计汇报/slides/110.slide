        [{ text: '单题解答与教学', textStyle: { fontWeight: 600, fontSize: 15 } }, { text: '题目及学生当前回答', textStyle: { fontSize: 15 } }, { text: '提供分步解释与即时帮助', textStyle: { fontSize: 15 } }, { text: '单次会话不足以建立完整能力画像', textStyle: { fontSize: 15 } }],
