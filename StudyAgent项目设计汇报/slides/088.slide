<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '20px 70px', display: 'flex', flexDirection: 'column' }}><Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}><Box style={{ flexDirection: 'column', gap: 6 }}><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4, letterSpacing: 1 }}>09 / MCP 接入</Text><Text style={{ fontSize: 32, color: '#0E2340', fontWeight: 700, lineHeight: 1.3 }}>MCP、Skill、插件与专用 Agent 各做什么</Text></Box><Box style={{ flexDirection: 'row', alignItems: 'center', padding: '7px 16px', borderRadius: 20, background: '#1E7BE0' }}><Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>设计中</Text></Box></Box><Box style={{ height: 532, paddingTop: 8, flexDirection: 'column' }}><Box style={{ flexDirection: 'column', flex: 1, paddingTop: 4 }}><Box style={{ marginBottom: 14 }}><Box style={{ flexDirection: 'row', alignItems: 'center', background: '#F5F7FA', borderLeft: '4px solid #0E2340', borderRadius: 6, padding: '14px 20px' }}><Text style={{ fontSize: 20, color: '#0E2340', fontWeight: 600, lineHeight: 1.5 }}>核心业务应能通过工具与普通结构化结果完成，不把 MCP Prompts、交互卡片或异步扩展设为所有客户端的必需条件</Text></Box></Box><Box style={{ flex: 1 }}><Table style={{ width: '100%', height: '100%' }} defaultTextStyle={{ fontSize: 16, textAlign: 'left', color: '#333A45' }} defaultCellStyle={{ padding: 10, border: { left: { width: 1, color: '#E3E8EF' }, right: { width: 1, color: '#E3E8EF' }, top: { width: 1, color: '#E3E8EF' }, bottom: { width: 1, color: '#E3E8EF' } } }} cells={[[{ text: '层次', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '职责', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '本项目交付方向', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }],
        [{ text: '业务服务', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '教学规则、评分、数据与任务的实际执行', textStyle: { fontSize: 16 } }, { text: '复用现有后端服务，不迁移逻辑', textStyle: { fontSize: 16 } }],
        [{ text: 'MCP Server', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '暴露工具、资源与结果引用', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '按业务领域提供清晰参数工具，按身份和场景暴露集合', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '资源与结果引用', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '解析、报告、题图与导出文件的受控访问', textStyle: { fontSize: 16 } }, { text: '默认简短摘要 + 按需读取结构化详情', textStyle: { fontSize: 16 } }],
        [{ text: 'Skill / 工作流说明', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '描述教育场景下的正确使用方式', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '随连接器或专家包提供', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '宿主插件或连接器', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '在宿主中安装与认证', textStyle: { fontSize: 16 } }, { text: '首期优先验证连接器', textStyle: { fontSize: 16 } }],
        [{ text: '教学协同 Agent', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '按角色组织多步流程', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '服务端持有角色规则，不由宿主提示词决定权限', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }]]} /></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：系统Agent适配与MCP插件接入设计.md §2</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 88 / 124 </Text></Box></Slide>