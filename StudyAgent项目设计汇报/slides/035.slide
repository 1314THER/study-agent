<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '20px 70px', display: 'flex', flexDirection: 'column' }}><Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}><Box style={{ flexDirection: 'column', gap: 6 }}><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4, letterSpacing: 1 }}>03 / 单题引擎</Text><Text style={{ fontSize: 32, color: '#0E2340', fontWeight: 700, lineHeight: 1.3 }}>与已有研究的比较定位（一）</Text></Box><Box style={{ flexDirection: 'row', alignItems: 'center', padding: '7px 16px', borderRadius: 20, background: '#1E7BE0' }}><Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>设计中</Text></Box></Box><Box style={{ height: 532, paddingTop: 8, flexDirection: 'column' }}><Box style={{ flexDirection: 'column', flex: 1, paddingTop: 4 }}><Box style={{ marginBottom: 14 }}><Box style={{ flexDirection: 'row', alignItems: 'center', background: '#F5F7FA', borderLeft: '4px solid #0E2340', borderRadius: 6, padding: '14px 20px' }}><Text style={{ fontSize: 20, color: '#0E2340', fontWeight: 600, lineHeight: 1.5 }}>下表是设计层面的对照，不表示已完成同条件实验</Text></Box></Box><Box style={{ flex: 1 }}><Table style={{ width: '100%', height: '100%' }} defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#333A45' }} defaultCellStyle={{ padding: 10, border: { left: { width: 1, color: '#E3E8EF' }, right: { width: 1, color: '#E3E8EF' }, top: { width: 1, color: '#E3E8EF' }, bottom: { width: 1, color: '#E3E8EF' } } }} cells={[[{ text: '相关工作', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '已研究的问题', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '启发与可比较之处', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#0E2340' } } }],
        [{ text: 'Stepwise Verification and Remediation（EMNLP 2024）', textStyle: { fontWeight: 600, fontSize: 15 } }, { text: '定位学生推理错误，并用验证结果指导反馈', textStyle: { fontSize: 15 } }, { text: '同样强调先有错误定位依据再给反馈；可比较共享步骤词表是否改善定位、作答对齐与后续训练选择', textStyle: { fontSize: 15 } }],
        [{ text: 'MathCog（2026 修订预印本）', textStyle: { fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '从手写作答诊断认知技能，区分证据明确与模糊', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '应比较证据不足时是否保留判断，是否产生无依据的知识缺陷归因', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: 'MathTutorBench（EMNLP 2025）', textStyle: { fontWeight: 600, fontSize: 15 } }, { text: '数学辅导能力评测；解题能力 ≠ 教学能力', textStyle: { fontSize: 15 } }, { text: '教学应单独评价：是否定位困难、提示是否有用、是否过早泄露答案', textStyle: { fontSize: 15 } }],
        [{ text: 'EQPR（ACL 2025）', textStyle: { fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '按多维教学目标规划、评价和优化数学出题', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '侧重有步骤和参考题的约束生成；可比较目标步骤命中、知识范围适配和题目正确性', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: 'Cognitive Tutor（IES 项目说明）', textStyle: { fontWeight: 600, fontSize: 15 } }, { text: '用学生思维的计算模型提供个性化数学教学', textStyle: { fontSize: 15 } }, { text: '应比较如何用现有大模型与可维护的步骤体系支持更多题目及开放作答', textStyle: { fontSize: 15 } }]]} /></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：单题功能设计思路.md §8</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 35 / 124 </Text></Box></Slide>