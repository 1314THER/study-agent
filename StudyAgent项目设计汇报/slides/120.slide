<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '20px 70px', display: 'flex', flexDirection: 'column' }}><Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}><Box style={{ flexDirection: 'column', gap: 6 }}><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4, letterSpacing: 1 }}>12 / 自进化与扩展</Text><Text style={{ fontSize: 32, color: '#0E2340', fontWeight: 700, lineHeight: 1.3 }}>科目扩展：什么可复用，什么必须重建</Text></Box><Box style={{ flexDirection: 'row', alignItems: 'center', padding: '7px 16px', borderRadius: 20, background: '#1E7BE0' }}><Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>设计中</Text></Box></Box><Box style={{ height: 532, paddingTop: 8, flexDirection: 'column' }}><Box style={{ flexDirection: 'column', flex: 1, paddingTop: 4 }}><Box style={{ marginBottom: 14 }}><Box style={{ flexDirection: 'row', alignItems: 'center', background: '#F5F7FA', borderLeft: '4px solid #0E2340', borderRadius: 6, padding: '14px 20px' }}><Text style={{ fontSize: 20, color: '#0E2340', fontWeight: 600, lineHeight: 1.5 }}>高中数学适合作为结构化起点，并不能据此推断其他科目更容易，或只替换知识点名称就能直接迁移；建议先选一个边界清晰的小单元试点</Text></Box></Box><Box style={{ flex: 1 }}><Table style={{ width: '100%', height: '100%' }} defaultTextStyle={{ fontSize: 16, textAlign: 'left', color: '#333A45' }} defaultCellStyle={{ padding: 10, border: { left: { width: 1, color: '#E3E8EF' }, right: { width: 1, color: '#E3E8EF' }, top: { width: 1, color: '#E3E8EF' }, bottom: { width: 1, color: '#E3E8EF' } } }} cells={[[{ text: '学科', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '可复用', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '需重建', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#0E2340' } } }],
        [{ text: '物理', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '分步作答、模型或题类训练、实验演示与时间线', textStyle: { fontSize: 16 } }, { text: '情境建模、受力与物理假设、单位和实验依据', textStyle: { fontSize: 16 } }],
        [{ text: '化学', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '方程与过程分析、知识关联、题库及复测', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '反应条件、物质性质、实验操作及可接受的解释', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: '语言类', textStyle: { fontWeight: 600, fontSize: 16 } }, { text: '长期档案、反馈、阅读与写作任务、个性化复习', textStyle: { fontSize: 16 } }, { text: '开放答案、语境、表达质量、篇章与多元评分量规', textStyle: { fontSize: 16 } }],
        [{ text: '历史等人文学科', textStyle: { fontWeight: 600, fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '来源记录、证据引用、教师审核和阶段评价', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '史料解释、论证质量、不同合理观点及时代背景', textStyle: { fontSize: 16 }, cellStyle: { background: { color: '#F5F7FA' } } }]]} /></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：自进化与跨学科扩展设计.md §5</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 120 / 124 </Text></Box></Slide>