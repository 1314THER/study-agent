<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: '20px 70px', display: 'flex', flexDirection: 'column' }}><Box style={{ height: 100, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}><Box style={{ flexDirection: 'column', gap: 6 }}><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4, letterSpacing: 1 }}>04 / 套路层面</Text><Text style={{ fontSize: 32, color: '#0E2340', fontWeight: 700, lineHeight: 1.3 }}>已有相近算法与初期可行方案</Text></Box><Box style={{ flexDirection: 'row', alignItems: 'center', padding: '7px 16px', borderRadius: 20, background: '#1E7BE0' }}><Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 600 }}>设计中</Text></Box></Box><Box style={{ height: 532, paddingTop: 8, flexDirection: 'column' }}><Box style={{ flexDirection: 'column', flex: 1, gap: 14 }}><Box style={{ height: 250 }}><Table style={{ width: '100%', height: '100%' }} defaultTextStyle={{ fontSize: 15, textAlign: 'left', color: '#333A45' }} defaultCellStyle={{ padding: 10, border: { left: { width: 1, color: '#E3E8EF' }, right: { width: 1, color: '#E3E8EF' }, top: { width: 1, color: '#E3E8EF' }, bottom: { width: 1, color: '#E3E8EF' } } }} cells={[[{ text: '工作', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '已有研究', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#0E2340' } } }, { text: '对本项目的边界', textStyle: { color: '#FFFFFF', fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#0E2340' } } }],
        [{ text: 'PFA（Performance Factors Analysis，AIED 2009）', textStyle: { fontWeight: 600, fontSize: 15 } }, { text: '知识成分的成功 / 失败历史建模', textStyle: { fontSize: 15 } }, { text: '论文知识成分与本项目 YAML 知识点不天然一一对应，需建立映射并拟合参数', textStyle: { fontSize: 15 } }],
        [{ text: 'HGKT（SIGIR 2022）', textStyle: { fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '引入 problem schema 建立分层习题图，用 K&amp;S 诊断矩阵', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '与本项目同时保留知识点和套路两种记录最接近；problem schema 不可直接等同步骤组合定义', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }],
        [{ text: 'Prerequisite-Driven Deep Knowledge Tracing', textStyle: { fontWeight: 600, fontSize: 15 } }, { text: '概念前置关系作结构约束', textStyle: { fontSize: 15 } }, { text: '不能把会做某套路硬推为所有前置知识均已掌握', textStyle: { fontSize: 15 } }],
        [{ text: 'Prerequisite Structure Discovery in ITS（ICDL 2023）', textStyle: { fontWeight: 600, fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '联合知识结构与知识追踪用于内容推荐', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }, { text: '其推荐评价用模拟学生，不能直接外推为真实高中生学习增益', textStyle: { fontSize: 15 }, cellStyle: { background: { color: '#F5F7FA' } } }]]} /></Box><Box style={{ flexDirection: 'row', alignItems: 'center', background: '#F5F7FA', borderLeft: '4px solid #1E7BE0', borderRadius: 6, padding: '14px 20px' }}><Text style={{ fontSize: 17, color: '#0E2340', fontWeight: 600, lineHeight: 1.5 }}>关键区分：知识追踪模型解决“下一次可能表现怎样”，还需推荐策略决定“下一项应该练什么”；预测准确 ≠ 推荐提高了学习效果</Text></Box></Box></Box><Box style={{ height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E3E8EF', marginTop: 8 }}><Text style={{ fontSize: 13, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}>依据：套路层面设计思路.md §5–§6</Text><Text style={{ fontSize: 14, color: '#7A8699', fontWeight: 400, lineHeight: 1.4 }}> 44 / 124 </Text></Box></Slide>